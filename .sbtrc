# Naming convention for aliases in this file:
#   - Type-based tests; `test<Type>` acts on whichever project is currently selected; no scope of their own:
#       `test`                       - unit tests only            (files/suites named `*UnitTests`)
#       `testIT`                     - integration tests only     (files/suites named `*IntegrationTests`)
#       `testStandard`               - both of the above combined ("standard", as opposed to the special kinds below)
#       `testCompatibility`          - Agent <-> Server compatibility tests (files/suites named `*CompatibilityTests`)
#
#   - Scoped-based tests; `test<Scope>` aliases always mean "run `testStandard` for exactly this scope":
#       `testAgentSpark3`            - both Spark 3 agent rows (Scala 2.12 + 2.13), recommended Java 11 runtime
#       `testAgentSpark4`            - the Spark 4 agent row (Scala 2.13), requires Java 17+
#       `testAgentReaderModelSpark3` - as `testAgentSpark3` but also with reader + model
#       `testAgentReaderModelSpark4` - as `testAgentSpark4` but also with reader + model
#       `testDB`                     - the `database` module
#
#   - `doc<Scope>` aliases mirror the `test<Scope>` scopes above but generate docs instead of running tests.

# Type-based tests
alias test=; testOnly *UnitTests
alias testIT=; testOnly *IntegrationTests
alias testStandard=; test; testIT
alias testCompatibility=; testOnly *CompatibilityTests

# Scope: agent, per Spark build row
alias testAgentSpark3=; project agent_spark3; testStandard; project agent_spark32_12; testStandard
alias testAgentSpark4=; project agent_spark4; testStandard
alias docAgentSpark3=; project agent_spark3; doc; project agent_spark32_12; doc
alias docAgentSpark4=; project agent_spark4; doc

# Scope: reader + model + a specific agent Spark build row
alias testAgentReaderModelSpark3=; project reader; testStandard; project model; testStandard; testAgentSpark3
alias docAgentReaderModelSpark3=; project reader; doc; project model; doc; docAgentSpark3

alias testAgentReaderModelSpark4=; project reader; testStandard; project model; testStandard; testAgentSpark4
alias docAgentReaderModelSpark4=; project reader; doc; project model; doc; docAgentSpark4

# Scope: database
alias testDB=; project database; testStandard

# Jacoco Aliases
alias jacoco=; jacocoOn; jacocoAgent; jacocoReader; jacocoModel; jacocoServer; jacocoOff

alias jacocoOn=; set every jacocoPluginEnabled := true
alias jacocoOff=; set every jacocoPluginEnabled := false

alias jacocoAgent=; project agent_spark3; clean; testOnly *UnitTests *IntegrationTests; jacocoReportAll
alias jacocoReader=; project reader; clean; testOnly *UnitTests *IntegrationTests; jacocoReportAll
alias jacocoModel=; project model; clean; testOnly *UnitTests *IntegrationTests; jacocoReportAll
alias jacocoServer=; project server; clean; testOnly *UnitTests *IntegrationTests; jacocoReportAll
